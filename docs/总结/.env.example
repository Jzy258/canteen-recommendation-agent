# ===== LLM 开关：true=云端 API，false=本地 Ollama =====
USE_CLOUD_API=false

# ===== LLM 配置（本地 Ollama，USE_CLOUD_API=false 时生效）=====
# 默认 qwen3.5:2b（最低 4GB 内存 / 推荐 8GB）；可选 qwen2.5:7b
#OLLAMA_BASE_URL=
#OLLAMA_MODEL=
#OLLAMA_EMBED_MODEL=bge-m3   # RAG embedding 模型（远程服务器用 bge-m3，默认 nomic-embed-text）

# ===== 云端 API（USE_CLOUD_API=true 时填写）=====
#OPENAI_API_KEY=
#OPENAI_BASE_URL=
#OPENAI_MODEL=

# ===== 天气 MCP（可选，配 key 后走高德真实 API，否则 mock 回退）=====
#WEATHER_API_KEY=
#WEATHER_BASE_URL=https://restapi.amap.com/v3/weather/weatherInfo
#GEOCODE_BASE_URL=https://restapi.amap.com/v3/geocode/geo
#IP_BASE_URL=https://restapi.amap.com/v3/ip

# ===== 数据库 =====
DB_PATH=backend/data/canteen.db

# ===== 后端 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000