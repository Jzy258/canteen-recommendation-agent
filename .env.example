# ===== LLM 配置（Ollama）=====
# 本地：OLLAMA_BASE_URL=http://localhost:11434
# 远程 LLM 服务器（仅部署 LLM+embedding）：OLLAMA_BASE_URL=http://<server-ip>:11434
OLLAMA_BASE_URL=http://119.45.135.201:11434
OLLAMA_MODEL=qwen2.5:7b
# RAG embedding 模型（远程服务器已装 bge-m3）
OLLAMA_EMBED_MODEL=bge-m3

# ===== 云端 API（可选，切换 LLM 供应商时填写）=====
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# ===== LLM 通用（可选）=====
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2

# ===== 天气 MCP（可选，配 key 后走高德真实 API，否则 mock 回退）=====
# 地理编码(查 adcode): https://lbs.amap.com/api/webservice/guide/api/georegeo
# 天气查询: https://lbs.amap.com/api/webservice/guide/api/weatherinfo
# GEOCODE_BASE_URL=https://restapi.amap.com/v3/geocode/geo
# WEATHER_BASE_URL=https://restapi.amap.com/v3/weather/weatherInfo
# WEATHER_API_KEY=

# ===== 数据库 =====
DB_PATH=backend/data/canteen.db

# ===== 后端 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
