# ===== LLM 配置（本地 Ollama）=====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== 云端 API（可选，切换 LLM 供应商时填写）=====
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# ===== LLM 通用（可选）=====
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2

# ===== 天气 MCP（可选，配 key 后走高德真实 API，否则 mock 回退）=====
